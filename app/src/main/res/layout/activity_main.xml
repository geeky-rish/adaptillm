<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FAFAFA">

    <!-- App Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AdaptiLLM"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adaptive On-Device Inference"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="32dp" />

    <!-- User Input Field -->
    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your prompt..."
        android:inputType="textMultiLine"
        android:minLines="3"
        android:maxLines="5"
        android:padding="16dp"
        android:background="@drawable/input_background"
        android:textSize="16sp"
        android:textColor="#1A1A2E"
        android:textColorHint="#9E9E9E"
        android:gravity="top|start" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <!-- Generate / Stop share the same space -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Generate"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="\u25A0 Stop"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

        </FrameLayout>

        <Button
            android:id="@+id/btnNewChat"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="New Chat"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#FF6B6B"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Output Section -->
    <TextView
        android:id="@+id/tvOutputLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Output"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output will appear here..."
            android:textSize="15sp"
            android:textColor="#424242"
            android:padding="16dp"
            android:background="@drawable/output_background"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

    <!-- Copy Buttons Row -->
    <LinearLayout
        android:id="@+id/copyButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Copy Output"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="#E8E6FF"
            android:textColor="#6C63FF" />

        <Button
            android:id="@+id/btnCopyCode"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Copy Code"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="#E6FFE8"
            android:textColor="#2E7D32" />

    </LinearLayout>

    <!-- Status Bar (displays current adaptive mode and battery %) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Ready | Initialize sensors..."
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#6C63FF"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#F0F0FF" />

</LinearLayout>
